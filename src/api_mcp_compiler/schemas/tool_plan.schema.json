{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:api-mcp-compiler:schema:tool-plan:0.3.0",
  "title": "Agent Tool Surface Plan",
  "description": "A proposed MCP surface for one service. A plan is a review artifact, not an executable one: nothing may be generated as executable while an artifact is still proposed.",
  "type": "object",
  "required": [
    "schema_version",
    "service_id",
    "planner",
    "source_digest",
    "artifacts"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.4.0"
    },
    "service_id": {
      "type": "string"
    },
    "planner": {
      "description": "Which planner produced the plan. The baseline planner exists only for controlled comparison and is never a production surface.",
      "enum": [
        "baseline",
        "semantic"
      ]
    },
    "source_digest": {
      "description": "Prefixed sha256 digest of the source specification bytes the plan was compiled from, so a stale plan is detectable.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "decisions": {
      "description": "Every rename, omission, grouping, projection and composite, with its rationale. The baseline planner makes no decisions and emits none.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    }
  },
  "$defs": {
    "provenance": {
      "description": "Records tracing the artifact back to the source operations it was derived from.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field",
          "source_pointer",
          "derivation",
          "rule"
        ],
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string"
          },
          "source_pointer": {
            "type": "string",
            "pattern": "^(openapi|wsdl):"
          },
          "derivation": {
            "enum": [
              "source",
              "normalized",
              "inferred",
              "default",
              "declared"
            ]
          },
          "rule": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "artifact_id",
        "kind",
        "name",
        "description",
        "source_operations",
        "risk",
        "review_status",
        "rationale"
      ],
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "tool",
            "resource",
            "prompt",
            "composite",
            "omitted"
          ]
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "source_operations": {
          "description": "Operation identifiers this artifact was derived from. Traceability to source operations must survive every planning stage.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risk": {
          "description": "Risk classification of the exposed artifact. This is a superset of the IR side-effect classes: privileged is a property of an exposed tool, not of a source operation, and may only be assigned by the semantic planner or policy synthesis.",
          "enum": [
            "read",
            "write",
            "destructive",
            "privileged",
            "unknown"
          ]
        },
        "review_status": {
          "enum": [
            "proposed",
            "approved",
            "rejected"
          ]
        },
        "rationale": {
          "type": "string"
        },
        "confidence": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "Agent-suitability score. Assigned by the semantic planner, because suitability is a planning judgement and writing it back into the IR would make ingestion depend on a planner."
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "group": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_fields": {
          "description": "Top-level response fields the tool projects. Empty means no projection.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "omitted_arguments": {
          "description": "Arguments withheld from the agent's input schema. They are optional in the source and are left off the wire, so the service applies its own default. Projection changes what an agent must reason about, never what the tool can do.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "decision": {
      "description": "One semantic decision with the reasoning a reviewer needs. A planner decision is a proposal below confidence 1.0; a human decision recorded in an overlay is a fact at 1.0.",
      "type": "object",
      "required": [
        "kind",
        "origin",
        "target",
        "rationale",
        "confidence",
        "applied"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "rename",
            "describe",
            "reclassify",
            "omit",
            "group",
            "project",
            "compose",
            "approve"
          ]
        },
        "origin": {
          "enum": [
            "planner",
            "human"
          ]
        },
        "target": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "applied": {
          "type": "boolean"
        },
        "previous_value": {
          "type": [
            "string",
            "null"
          ]
        },
        "proposed_value": {
          "type": [
            "string",
            "null"
          ]
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    }
  }
}
