{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:api-mcp-compiler:schema:policy-manifest:0.4.0",
  "title": "MCP Policy Manifest",
  "description": "The governance envelope for a generated tool surface. Policy generation is separate from code generation, because a generator that also decided policy could be reviewed as neither. Anything that cannot be derived is named in `unresolved`, and generation fails closed rather than defaulting it.",
  "type": "object",
  "required": [
    "schema_version",
    "service_id",
    "source_digest",
    "policies"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.4.0"
    },
    "service_id": {
      "type": "string"
    },
    "source_digest": {
      "description": "Digest shared with the IR, plan and surface, so a manifest cannot be applied to a revision it was not derived from.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "policies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/toolPolicy"
      }
    },
    "list_cache": {
      "description": "How long a client may cache the surface's lists and whether it may share them. A cached tools/list outlives a revocation by up to ttl_ms, so the TTL is derived from what the surface can do.",
      "anyOf": [
        {
          "$ref": "#/$defs/listCachePolicy"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field",
          "source_pointer",
          "derivation",
          "rule"
        ],
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string"
          },
          "source_pointer": {
            "type": "string",
            "pattern": "^(openapi|wsdl):"
          },
          "derivation": {
            "enum": [
              "source",
              "normalized",
              "inferred",
              "default",
              "declared"
            ]
          },
          "rule": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "rateBudget": {
      "description": "Call rate, concurrency and daily budget. Budgeted by risk, because a mistake costs more the more the tool can do.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "calls_per_minute": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "max_concurrent": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "daily_call_budget": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "outputPolicy": {
      "description": "What a tool may return. Exceeding max_bytes yields a structured refusal rather than truncated data, because truncating a payload produces something that parses as an answer while being wrong.",
      "type": "object",
      "required": [
        "max_bytes"
      ],
      "additionalProperties": false,
      "properties": {
        "max_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "projected_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "redact_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "confirmationPolicy": {
      "description": "A requirement that a destructive call is confirmed before it runs, bound to the arguments it was given for. On the SDK 2.x target a person confirms through an MCP elicitation and the pending call travels in sealed request state; on the 1.x target the confirmation is a second identical call, which an agent can make itself.",
      "type": "object",
      "required": [
        "effect_summary"
      ],
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "effect_summary": {
          "type": "string"
        },
        "token_ttl_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "toolPolicy": {
      "type": "object",
      "required": [
        "artifact_id",
        "tool_name",
        "approval",
        "retry",
        "rate",
        "log_class",
        "sensitivity",
        "output"
      ],
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "tool_name": {
          "type": "string"
        },
        "required_scopes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The narrowest requirement that grants access, not the union across alternatives."
        },
        "approval": {
          "enum": [
            "none",
            "user_confirmation",
            "human_approval",
            "disabled"
          ]
        },
        "confirmation": {
          "oneOf": [
            {
              "$ref": "#/$defs/confirmationPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "retry": {
          "enum": [
            "never",
            "safe",
            "with_idempotency_key"
          ]
        },
        "idempotency_key_required": {
          "type": "boolean"
        },
        "rate": {
          "$ref": "#/$defs/rateBudget"
        },
        "allowed_environments": {
          "type": "array",
          "items": {
            "enum": [
              "development",
              "staging",
              "production"
            ]
          }
        },
        "log_class": {
          "enum": [
            "minimal",
            "standard",
            "sensitive"
          ]
        },
        "sensitivity": {
          "description": "A separate axis from the side-effect class: a read of financial data is still financial, so folding it into read/write/destructive would make it unrepresentable on the operations that leak it.",
          "enum": [
            "public",
            "internal",
            "confidential",
            "personal",
            "financial"
          ]
        },
        "output": {
          "$ref": "#/$defs/outputPolicy"
        },
        "rollback_guidance": {
          "type": [
            "string",
            "null"
          ]
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "What could not be derived. A tool with any entry here is refused emission rather than defaulted."
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "required_schemes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Identifiers of the security schemes whose credentials a caller must present, taken from the alternative least-privilege selection chose. Empty when the specification declares no authentication for the operation."
        },
        "routing_headers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/routingHeader"
          }
        }
      }
    },
    "listCachePolicy": {
      "description": "List-result freshness hints in MCP 2026-07-28 terms (ttlMs, cacheScope).",
      "type": "object",
      "required": [
        "ttl_ms",
        "scope"
      ],
      "additionalProperties": false,
      "properties": {
        "ttl_ms": {
          "type": "integer",
          "minimum": 0
        },
        "scope": {
          "enum": [
            "public",
            "private"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "routingHeader": {
      "description": "A tool argument a client mirrors into an Mcp-Param-{header} HTTP header, so a gateway can route or enforce on it. Only identifiers of the thing acted on qualify; never free text, never anything redaction flags.",
      "type": "object",
      "required": [
        "argument",
        "header"
      ],
      "additionalProperties": false,
      "properties": {
        "argument": {
          "type": "string"
        },
        "header": {
          "type": "string",
          "pattern": "^[A-Za-z0-9!#$%&'*+.^_`|~-]+$"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    }
  }
}
